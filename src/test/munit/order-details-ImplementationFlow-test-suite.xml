<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="order-details-ImplementationFlow-test-suite.xml" />
	<munit:test name="order-details-ImplementationFlow-eecol-test-suite" doc:id="b7e4b3b3-589f-4e40-8576-c338117d0540" description="Test">
		<munit:behavior >
			<munit-tools:mock-when doc:name="sap eee" doc:id="6d3dceb7-6648-417a-9fae-2e91b3c990d7" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="sap eee12 Request" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[MunitTools::getResourceAsString('order-details-response.json')]" mediaType="application/json" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="625e7be7-e7eb-4f08-880e-e5d1bc8f3c7b" >
				<munit:payload value="#[MunitTools::getResourceAsString('order-detail-eecol-request.json')]" mediaType="application/json" />
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to post:\v1\orders\details:application\json:poc-papi-orders-config" doc:id="2f68fb7f-8b30-4119-836b-54ae86131620" name="post:\v1\orders\details:application\json:poc-papi-orders-config"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:verify-call doc:name="Verify call" doc:id="e5c05491-2468-4f05-9642-a468e04f3452" processor="logger" atLeast="1">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="***end flow***" attributeName="doc:name" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>
	
	
	
	<munit:test name="order-details-ImplementationFlow-anixter-test-suite" doc:id="6423ca2c-c42b-492b-af2d-61a9ce570acf" description="Test">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Anixter" doc:id="903c1d18-4799-4dab-940e-2745c6f05faf" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="sapi Anixter Request" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[MunitTools::getResourceAsString('order-details-response.json')]" mediaType="application/json" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="4700ee7c-ed86-4fec-8d7d-1577ca0c2007" >
				<munit:payload value="#[MunitTools::getResourceAsString('order-details-request-anixter.json')]" mediaType="application/json" />

			</munit:set-event>
			<flow-ref doc:name="Flow-ref to post:\v1\orders\details:application\json:poc-papi-orders-config" doc:id="e1338615-686d-4e1c-bf13-0e9d245a79a7" name="post:\v1\orders\details:application\json:poc-papi-orders-config"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:verify-call doc:name="Verify call" doc:id="299d027e-87c3-4554-ad70-78bc08583b95" processor="logger">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="***end flow***" attributeName="doc:name" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>

		</munit:validation>
	
</munit:test>
	
